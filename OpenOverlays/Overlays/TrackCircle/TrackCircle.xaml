<Window x:Class="OpenOverlays.Overlays.TrackCircle.TrackCircle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Track Circle" Height="250" Width="250"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False">
    <Grid>
        <!-- Background Track Ring -->
        <Ellipse x:Name="TrackRing" Margin="10" Stroke="#1AFFFFFF" StrokeThickness="12"/>
        
        <!-- Active Selection Glow (Subtle) -->
        <Ellipse Margin="8" Stroke="#3300D1FF" StrokeThickness="16">
            <Ellipse.Effect>
                <BlurEffect Radius="10"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Main HUD Ring -->
        <Ellipse Margin="10" Stroke="#FF00D1FF" StrokeThickness="2" Opacity="0.8"/>
        
        <!-- Car Layer -->
        <Canvas x:Name="CarCanvas" Margin="10">
            <!-- Cars will be added here dynamically -->
        </Canvas>
    </Grid>
</Window>
