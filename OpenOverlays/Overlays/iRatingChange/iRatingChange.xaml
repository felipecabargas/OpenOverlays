<Window x:Class="OpenOverlays.Overlays.iRatingChange.iRatingChange"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iRating Change" Height="60" Width="140"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False">
    <Border Background="#FF0D0D0D" BorderThickness="4,0,0,0" BorderBrush="#FF00D1FF" Padding="10,5">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock x:Name="iRatingText" 
                       Style="{StaticResource HUDHeader}" 
                       FontSize="20" 
                       Text="+0" 
                       Foreground="#FF32CD32"/>
            <TextBlock x:Name="SOFLabel" 
                       Style="{StaticResource HUDSecondary}" 
                       FontSize="10" 
                       Text="SOF 0" 
                       HorizontalAlignment="Right"/>
        </StackPanel>
    </Border>
</Window>
