<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- HUD Palette -->
    <Color x:Key="HUDBackgroundColor">#FF0D0D0D</Color>
    <Color x:Key="HUDCyanColor">#FF00D1FF</Color>
    <Color x:Key="HUDGreenColor">#FF32CD32</Color>
    <Color x:Key="HUDRedColor">#FFFF4500</Color>
    <Color x:Key="HUDGreyColor">#FF808080</Color>

    <SolidColorBrush x:Key="HUDBackgroundBrush" Color="{StaticResource HUDBackgroundColor}"/>
    <SolidColorBrush x:Key="HUDCyanBrush" Color="{StaticResource HUDCyanColor}"/>
    <SolidColorBrush x:Key="HUDGreyBrush" Color="{StaticResource HUDGreyColor}"/>

    <!-- Typography -->
    <Style x:Key="HUDHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift, Inter, Segoe UI"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="24"/>
    </Style>

    <Style x:Key="HUDSecondary" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift, Inter, Segoe UI"/>
        <Setter Property="Foreground" Value="{StaticResource HUDGreyBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Control Styles -->
    <Style x:Key="HUDButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="SelectionBorder" BorderThickness="2,0,0,0" BorderBrush="Transparent"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#11FFFFFF"/>
                            <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource HUDCyanBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Legacy Style Mapping -->
    <Style x:Key="LiquidGlassButton" TargetType="Button" BasedOn="{StaticResource HUDButton}"/>

</ResourceDictionary>
